{"units": {"G1": [["halò", "ha-LOH", "hello"], ["madainn mhath", "MAH-ting VAH", "good morning"], ["feasgar math", "FES-kur MAH", "good afternoon or good evening"], ["oidhche mhath", "OY-khyuh VAH", "good night"], ["ciamar a tha thu", "KIM-er uh HA oo", "how are you, said to one friend"], ["ciamar a tha sibh", "KIM-er uh HA shiv", "how are you, said politely or to more than one person"], ["tha gu math", "HA goo MAH", "I am well"], ["tapadh leat", "TAH-puh let", "thank you, to a friend"], ["tapadh leibh", "TAH-puh LAY-iv", "thank you, politely"], ["mar sin leat", "mar SHIN let", "goodbye, to a friend"]], "G2": [["bàta", "BAH-tuh", "boat"], ["taigh", "TIE", "house"], ["mòr", "MORE", "big"], ["beag", "BAKE", "small"], ["cù", "KOO", "dog"], ["loch", "LOKH", "lake or loch"], ["bhàta", "VAH-tuh", "boat, with a softened first sound"], ["mo thaigh", "mo HIE", "my house"]], "G3": [["is mise", "iss MEE-shuh", "I am, used with your name"], ["is mise Jonathan", "iss MEE-shuh Jonathan", "I am Jonathan"], ["dè an t-ainm a th' ort", "JAY un TAN-um uh HORSHT", "what is your name"], ["cò às a tha thu", "KOH ass uh HA oo", "where are you from"], ["tha mi à Hawaii", "HA mee ah Hawaii", "I am from Hawaii"], ["MacAoidh", "mac-KOO-ee", "MacKay, the Gaelic form of your family name"], ["tha mi toilichte coinneachadh riut", "HA mee TOL-eekh-tyuh KON-yakh-ugh root", "I am pleased to meet you"]], "N1": [["a h-aon", "uh HUHN", "one, when counting"], ["a dhà", "uh GHAH", "two"], ["a trì", "uh TREE", "three"], ["a ceithir", "uh KAY-hir", "four"], ["a còig", "uh KOH-ik", "five"]], "N2": [["a sia", "uh SHEE-uh", "six"], ["a seachd", "uh SHAKHK", "seven"], ["a h-ochd", "uh HOKHK", "eight"], ["a naoi", "uh NUH-ee", "nine"], ["a deich", "uh JAYKH", "ten"]], "N3": [["a h-aon deug", "uh HUHN jee-ak", "eleven"], ["a dhà dheug", "uh GHAH yee-ak", "twelve"], ["a trì deug", "uh TREE jee-ak", "thirteen"], ["a còig deug", "uh KOH-ik jee-ak", "fifteen"], ["a naoi deug", "uh NUH-ee jee-ak", "nineteen"], ["fichead", "FEE-khut", "twenty"]], "B1": [["tha mi", "HA mee", "I am"], ["tha thu", "HA oo", "you are"], ["tha e", "HA eh", "he is, or it is"], ["tha i", "HA ee", "she is"], ["tha sinn", "HA shin", "we are"], ["tha iad", "HA ee-ut", "they are"], ["tha mi sgìth", "HA mee SKEE", "I am tired"], ["tha mi toilichte", "HA mee TOL-eekh-tyuh", "I am happy"]], "B2": [["chan eil", "khahn YELL", "is not, or am not"], ["chan eil mi", "khahn YELL mee", "I am not"], ["chan eil mi sgìth", "khahn YELL mee SKEE", "I am not tired"], ["chan eil e fuar", "khahn YELL eh FOO-ur", "it is not cold"], ["tha e blàth", "HA eh BLAH", "it is warm"], ["chan eil i trang", "khahn YELL ee TROWNG", "she is not busy"]], "B3": [["a bheil", "uh VALE", "is, or are, at the start of a question"], ["a bheil thu sgìth", "uh VALE oo SKEE", "are you tired"], ["tha", "HA", "yes, literally it is"], ["chan eil", "khahn YELL", "no, literally it is not"], ["a bheil e fuar", "uh VALE eh FOO-ur", "is it cold"], ["a bheil thu trang", "uh VALE oo TROWNG", "are you busy"]], "Q": [["dè", "JAY", "what"], ["cò", "KOH", "who"], ["càite", "KAHT-chuh", "where"], ["ciamar", "KIM-er", "how"], ["càite a bheil thu", "KAHT-chuh uh VALE oo", "where are you"], ["dè tha seo", "JAY ha SHAW", "what is this"], ["cò tha seo", "KOH ha SHAW", "who is this"]], "F1": [["màthair", "MAH-hir", "mother"], ["athair", "AH-hir", "father"], ["bràthair", "BRAH-hir", "brother"], ["piuthar", "PYOO-ur", "sister"], ["mac", "MAHK", "son"], ["nighean", "NEE-un", "daughter or girl"], ["seanair", "SHEN-er", "grandfather"], ["seanmhair", "SHEN-uh-vir", "grandmother"]], "F2": [["mo mhàthair", "mo VAH-hir", "my mother"], ["m' athair", "MAH-hir", "my father"], ["mo bhràthair", "mo VRAH-hir", "my brother"], ["mo phiuthar", "mo FYOO-ur", "my sister"], ["tha bràthair agam", "HA BRAH-hir AH-kum", "I have a brother"], ["seo mo mhàthair", "SHAW mo VAH-hir", "this is my mother"]]}, "mn": {"cù": "KOO sounds like the start of cute, and a dog is cute.", "beag": "Small, BAKE, like a small bake, a little biscuit.", "mòr": "Big, MORE. More is bigger.", "taigh": "House, TIE. You tie your boat up by your house.", "trì": "Three, TREE. Three trees.", "sia": "Six, SHEE-uh. She has six.", "dè": "What, JAY. Jay asks what.", "cò": "Who, KOH. Who is KOH?", "bràthair": "Brother, BRAH-hir, sounds like brother itself.", "màthair": "Mother, MAH-hir, sounds like mother.", "fuar": "Cold, FOO-ur. Brr, it's cold, say FOO-ur!", "seanair": "Grandfather, SHEN-er. A senior."}}